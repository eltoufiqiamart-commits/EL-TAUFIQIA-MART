# =============================================================================
# Toufiqia Mart — environment variables
# Copy this file to .env.local (development) and to your host's environment
# variable settings (production/preview). NEVER commit a file containing real
# secrets. Names only are listed below — no real values.
# =============================================================================

# --- SERVER-ONLY — never exposed to the browser --------------------------------

# PostgreSQL connection string (Supabase: Project Settings -> Database ->
# Connection string -> URI, using the pooled "Transaction" connection for
# serverless environments).
DATABASE_URL=postgresql://user:password@host:5432/database

# Secret used to sign session JWTs. Required in production. Must be a long,
# random string (32+ characters). Generate with: openssl rand -base64 48
JWT_SECRET=

# One-time bootstrap endpoint (/api/admin/init) secret. Required to create the
# very first admin account on a fresh database. Generate a long random value,
# set it in your host's env vars, call the endpoint once with header
# `x-init-secret: <value>`, then you may rotate/remove it.
INIT_SECRET=

# Credentials for the single admin account created by /api/admin/init.
# No defaults are used — both must be set explicitly. Password must be 12+
# characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Supabase project (server-side use, e.g. Storage uploads via service role).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Storage bucket name for product images. Defaults to
# "product-images" if unset. The server will attempt to create this bucket
# automatically (as public) the first time an image is uploaded; you can
# also create it yourself in the Supabase dashboard beforehand — see
# docs/supabase-storage.md.
SUPABASE_STORAGE_BUCKET=product-images

# --- PUBLIC — safe to expose to the browser (must be prefixed NEXT_PUBLIC_) ----

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_SITE_URL=https://your-domain.example

# --- Environment ---------------------------------------------------------------
# Next.js sets NODE_ENV automatically (development/production); you normally
# do not need to set this yourself.
# NODE_ENV=production
